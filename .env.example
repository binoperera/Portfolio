# --- Required, always ---

# Password to sign in to /admin. Change this to something only you know.
ADMIN_PASSWORD=Binowan@714

# Any long random string, used to sign the admin login session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=53c21493-4214-4d16-8643-a75b4f1ce8d0

# --- Required only in production (Vercel) ---
# Locally, if these are left unset, data is stored in ./data/local-db.json
# and résumé uploads go to ./public/uploads — nothing to configure to try
# the app out on your own machine.

# Redis (Storage tab -> Marketplace -> Redis, e.g. the Upstash integration).
# Vercel fills these in automatically once you connect a Redis store to the project.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (Storage tab -> Blob -> Create). Vercel fills this in automatically
# when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=
